{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/styles": [
        "src/styles"
      ],
      "@/components": [
        "src/components"
      ],
      "@/screens": [
        "src/screens"
      ],
      "@/types": [
        "src/types"
      ],
      "@/utils": [
        "src/utils"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
